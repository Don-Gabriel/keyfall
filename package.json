{
  "name": "keyfall",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "build": "vite build",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.js",
    "desktop": "electron .",
    "desktop:smoke": "electron .",
    "package:mac": "electron-builder --config electron-builder.yml --mac zip --universal",
    "native:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3",
    "@tonejs/midi": "^2.0.28",
    "fflate": "^0.8.2",
    "midi-file": "1.2.4",
    "opensheetmusicdisplay": "^1.9.7",
    "spessasynth_lib": "^4.4.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "vite": "^7.2.2"
  },
  "description": "Offline piano practice with falling notes, MIDI input, recording and sheet music",
  "author": "Don Gabriel",
  "license": "MIT",
  "main": "desktop/main.cjs"
}
